<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/nav_home"

    app:startDestination="@id/gamesFragment">

    <fragment
        android:id="@+id/gamesFragment"
        android:name="com.example.gamevault.home.games.GamesFragment"
        android:label="Inicio"
        tools:layout="@layout/fragment_games">

        <action
            android:id="@+id/action_gamesFragment_to_gameDetailFragment"
            app:destination="@id/gameDetailFragment"/>

    </fragment>

    <fragment
        android:id="@+id/gameDetailFragment"
        android:name="com.example.gamevault.home.gameDetail.GameDetailFragment"
        android:label="Detalle"
        tools:layout="@layout/fragment_game_detail">

        <argument
            android:name="gameId"
            app:argType="string"/>

    </fragment>

    <fragment
        android:id="@+id/wishlistFragment"
        android:name="com.example.gamevault.home.wishlist.WishlistFragment"
        android:label="Favoritos"
        tools:layout="@layout/fragment_wishlist"/>

    <fragment
        android:id="@+id/item_account"
        android:name="com.example.gamevault.home.account.AccountFragment"
        android:label="Cuenta"
        tools:layout="@layout/fragment_account"/>

</navigation>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Mi lista"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="4dp"

        android:text="0 juegos guardados"
        android:textColor="#DDDDDD"

        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="0dp"
        android:layout_height="50dp"

        android:layout_marginTop="20dp"

        android:background="@drawable/bg_search_bar"

        android:hint="Buscar en mi lista..."
        android:textColor="#000000"
        android:textColorHint="#888888"

        android:paddingHorizontal="16dp"

        app:layout_constraintTop_toBottomOf="@id/tvCount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWishlist"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:layout_marginTop="16dp"

        android:visibility="gone"
        android:scrollbars="none"

        app:layout_constraintTop_toBottomOf="@id/etSearch"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        tools:listitem="@layout/item_wishlist"
        tools:visibility="visible"/>

    <LinearLayout
        android:id="@+id/layoutEmpty"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:gravity="center"

        android:visibility="gone"

        app:layout_constraintTop_toBottomOf="@id/etSearch"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"

            android:src="@drawable/ic_heart"

            app:tint="#FFFFFF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"

            android:text="Aún no tienes juegos guardados"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExplorar"

            android:layout_width="wrap_content"
            android:layout_height="50dp"

            android:layout_marginTop="16dp"

            android:text="Explorar juegos"

            android:textColor="#FFFFFF"

            app:backgroundTint="#7C3AED"
            app:cornerRadius="24dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>